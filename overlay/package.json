{
  "name": "hota-twitch-overlay",
  "version": "1.0.0",
  "private": true,
  "description": "Twitch extension pages for Heroes III: Horn of the Abyss",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs --package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "node dev/serve.mjs",
    "shots": "node dev/screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
