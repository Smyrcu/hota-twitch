# Layered on top of the repository root .editorconfig, which turns every analyzer diagnostic
# into a warning and, through TreatWarningsAsErrors, into a build error. This file states the
# style this solution is written in, so the rules pass by agreement rather than by suppression.

[*.cs]

## Expression bodies
csharp_style_expression_bodied_methods = true
csharp_style_expression_bodied_constructors = true
csharp_style_expression_bodied_operators = true
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_indexers = true
csharp_style_expression_bodied_accessors = true
csharp_style_expression_bodied_lambdas = true
csharp_style_expression_bodied_local_functions = true

## Modern language features
csharp_style_namespace_declarations = file_scoped
csharp_using_directive_placement = outside_namespace
csharp_prefer_braces = true
csharp_style_prefer_primary_constructors = true
csharp_style_prefer_pattern_matching = true
csharp_style_prefer_not_pattern = true
csharp_style_prefer_switch_expression = true
csharp_style_prefer_range_operator = true
csharp_style_prefer_index_operator = true
csharp_style_implicit_object_creation_when_type_is_apparent = true
csharp_prefer_simple_using_statement = true
csharp_style_prefer_utf8_string_literals = true
dotnet_style_collection_initializer = true
dotnet_style_prefer_collection_expression = when_types_loosely_match
dotnet_style_object_initializer = true
dotnet_style_prefer_conditional_expression_over_assignment = true
dotnet_style_prefer_conditional_expression_over_return = true
dotnet_style_namespace_match_folder = true

## Qualification and types
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true

## Rules that do not fit this solution
# IDE0058: discarding a return value is normal in builder chains and in EF/DI configuration.
dotnet_diagnostic.IDE0058.severity = none
# CA1062: nullable reference types already carry the contract; explicit guards stay where they matter.
dotnet_diagnostic.CA1062.severity = none
# CA2007: this is an ASP.NET Core application, there is no synchronization context to capture.
dotnet_diagnostic.CA2007.severity = none
# CA1515: the API assembly is exercised by HotaTwitch.Api.Tests through WebApplicationFactory.
dotnet_diagnostic.CA1515.severity = none
# CA1812: handlers, filters and hosted services are instantiated by the container.
dotnet_diagnostic.CA1812.severity = none
# CA1848 stays on: logging goes through [LoggerMessage] source generators (owner rule).
dotnet_diagnostic.CA1848.severity = error

[tests/**/*.cs]
# CA1707: test names read as Method_Scenario_Expectation.
dotnet_diagnostic.CA1707.severity = none
